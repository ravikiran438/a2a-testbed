# Copy this file to `.env.production` (or `.env.local` for testing)
# and fill in real values. None of these are required for local dev.

# Cloudflare Web Analytics — privacy-respecting, cookie-less.
# Get a site token at:
#   https://dash.cloudflare.com  →  Analytics → Web Analytics → Add site
# When unset, no analytics script is injected and the playground
# behaves identically.
VITE_CF_ANALYTICS_TOKEN=
